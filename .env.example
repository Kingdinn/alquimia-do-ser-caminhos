# Configuração local. Nunca coloque credenciais reais neste arquivo de exemplo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GOOGLE_AUTH_ENABLED=false
EMAIL_AUTH_READY=false

# Apoio: estes dois valores são públicos e entram na compilação do navegador.
# Use somente dados de recebimento que o proprietário escolheu publicar.
NEXT_PUBLIC_SUPPORT_PIX_CODE=
NEXT_PUBLIC_SUPPORT_URL=

# Calendar opcional. Valores abaixo são exclusivamente do servidor.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
SUPABASE_SECRET_KEY=
# Alternativa legada, apenas se necessária; nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
